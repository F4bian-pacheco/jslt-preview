{
  "name": "jslt-preview",
  "displayName": "JSLT Preview",
  "description": "Transforma archivos JSON con JSLT y visualiza los resultados en tiempo real con actualización automática al guardar",
  "version": "1.0.6",
  "publisher": "FabianPacheco",
  "icon": "resources/jslt-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/F4bian-pacheco/jslt-preview"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "jslt",
    "json",
    "transformation",
    "preview",
    "template"
  ],
  "activationEvents": [
    "onLanguage:json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jslt",
        "aliases": [
          "JSLT",
          "jslt"
        ],
        "extensions": [
          ".jslt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jslt",
        "scopeName": "source.jslt",
        "path": "./syntaxes/jslt.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "jslt-preview.transformWithJslt",
        "title": "Transformar con JSLT",
        "icon": "$(play)"
      },
      {
        "command": "jslt-preview.openPreview",
        "title": "Abrir Preview JSLT",
        "icon": "$(open-preview)"
      },
      {
        "command": "jslt-preview.selectJsonFile",
        "title": "JSLT: Cambiar JSON de contexto",
        "icon": "$(json)"
      },
      {
        "command": "jslt-preview.selectJsltFile",
        "title": "JSLT: Abrir archivo JSLT",
        "icon": "$(file-code)"
      },
      {
        "command": "jslt-preview.refreshExplorer",
        "title": "JSLT: Refrescar explorador",
        "icon": "$(refresh)"
      },
      {
        "command": "jslt-preview.transformCurrent",
        "title": "JSLT: Transformar con archivo actual",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "jslt-preview.transformWithJslt",
          "when": "resourceExtname == .json",
          "group": "navigation"
        },
        {
          "command": "jslt-preview.openPreview",
          "when": "resourceExtname == .jslt",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "jslt-preview.refreshExplorer",
          "when": "view == jsltExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "jslt-preview.transformCurrent",
          "when": "view == jsltExplorer && viewItem == jsltFile",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jslt-preview",
          "title": "JSLT Preview",
          "icon": "resources/jslt-icon.svg"
        }
      ]
    },
    "views": {
      "jslt-preview": [
        {
          "id": "jsltExplorer",
          "name": "JSLT Explorer",
          "icon": "resources/jslt-icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "JSLT Preview",
      "properties": {
        "jsltPreview.apiEndpoint": {
          "type": "string",
          "default": "http://localhost:8000/api/v1/transform",
          "description": "URL del endpoint de la API JSLT"
        },
        "jsltPreview.apiTimeout": {
          "type": "number",
          "default": 5000,
          "description": "Timeout en milisegundos para las peticiones a la API"
        },
        "jsltPreview.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Actualizar automáticamente el preview al guardar archivos JSLT o JSON"
        },
        "jsltPreview.defaultJsonFile": {
          "type": "string",
          "default": "",
          "description": "Ruta del archivo JSON predeterminado para el preview"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.0",
    "@types/vscode": "^1.106.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
