{
    "name": "JSLT",
    "scopeName": "source.jslt",
    "fileTypes": ["jslt"],
    "patterns": [
        { "include": "#comments" },
        { "include": "#keywords" },
        { "include": "#operators" },
        { "include": "#functions" },
        { "include": "#variables" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#properties" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.jslt",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.jslt",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.jslt",
                    "match": "\\b(let|if|else|for|def|import|as)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.logical.jslt",
                    "match": "\\b(and|or|not)\\b"
                },
                {
                    "name": "keyword.operator.comparison.jslt",
                    "match": "(==|!=|<=|>=|<|>)"
                },
                {
                    "name": "keyword.operator.arithmetic.jslt",
                    "match": "(\\+|-|\\*|/|%)"
                },
                {
                    "name": "keyword.operator.assignment.jslt",
                    "match": "="
                },
                {
                    "name": "keyword.operator.pipe.jslt",
                    "match": "\\|"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.jslt",
                    "match": "\\b(size|string|number|boolean|round|not|contains|starts-with|ends-with|split|join|flatten|reverse|sum|all|any|min|max|floor|ceil|abs|parse-time|format-time|is-string|is-number|is-array|is-object|is-boolean|is-null|get-key|fallback|error|test)\\b"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.jslt",
                    "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
                }
            ]
        },
        "properties": {
            "patterns": [
                {
                    "name": "variable.other.property.jslt",
                    "match": "\\.[a-zA-Z_][a-zA-Z0-9_-]*"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.jslt",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.jslt",
                            "match": "\\\\([\"\\\\/bfnrt]|u[0-9a-fA-F]{4})"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.jslt",
                    "match": "\\b([0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.jslt",
                    "match": "\\b(true|false|null)\\b"
                }
            ]
        }
    }
}
